<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- xUnit v3 : chaque projet de tests est un petit programme exécutable -->
    <OutputType>Exe</OutputType>
    <!-- Projet de tests : jamais publié comme paquet NuGet -->
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 : l'analyseur xUnit conseille de passer TestContext.Current.CancellationToken
         à chaque appel HTTP, pour pouvoir interrompre un test plus vite. Nos tests durent
         chacun moins d'une seconde : ce gain ne vaut pas d'alourdir chaque ligne. Règle
         désactivée volontairement, pour ce projet uniquement. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- "using Xunit;" ajouté automatiquement dans tous les fichiers de tests -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PresentationApi\PresentationApi.csproj" />
  </ItemGroup>

</Project>
