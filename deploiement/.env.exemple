# Réglages du serveur. Ne pas modifier ce fichier : le copier en « .env »
# (preparer.sh le fait et génère les mots de passe techniques), puis compléter .env.
# ⚠️ .env contient des mots de passe : il ne doit jamais être publié (il est ignoré par git).

# Adresse du site, sans https:// : un nom de domaine qui pointe vers l'adresse IP du serveur,
# ou, sans nom de domaine, l'adresse IP écrite avec des tirets + .sslip.io (ex. 203-0-113-7.sslip.io)
DOMAINE=

# Votre compte administrateur. Au premier démarrage, il remplace le compte public
# admin@ferme.local / Admin123. Mot de passe : 8 caractères au moins, majuscule, minuscule, chiffre.
ADMIN_EMAIL=
ADMIN_NOM=
ADMIN_MOT_DE_PASSE=

# Mots de passe techniques (générés par preparer.sh). Lettres et chiffres uniquement.
MOT_DE_PASSE_BASE=
MOT_DE_PASSE_ROOT_BASE=
# Clé de signature des jetons de connexion (64 caractères). La changer déconnecte tout le monde.
CLE_JWT=

# Nombre de jours de sauvegardes gardés sur le serveur
CONSERVER_JOURS=14
