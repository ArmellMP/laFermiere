<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a7c2eeb4-01e1-4d44-8b63-a22a6f869f81</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAPI -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    
    <!-- Swagger UI : uniquement l'interface web. Le document OpenAPI est généré
         par Microsoft.AspNetCore.OpenApi (ci-dessus), compatible .NET 10. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />

    <!-- HealthChecks -->
    <PackageReference Include="AspNetCore.HealthChecks.MySql" Version="9.0.0" />
    
    <!-- Authentification JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
  </ItemGroup>

  <!-- RÉFÉRENCES VERS LES AUTRES PROJETS -->
  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

</Project>